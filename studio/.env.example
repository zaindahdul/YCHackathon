# Copy to studio/.env. Real values stay local and ignored by Git.
# Exported variables override these settings; studio/.env overrides the root .env.
PORT=8790
# Optional: change the loopback-only development bearer.
PMF_DEV_TOKEN=dev
NAIVE_API_KEY=
# Set only after the owner authorizes a finite paid founder run.
STUDIO_LIVE_AUTHORIZED=false
STUDIO_TOTAL_BUDGET_CENTS=0
STUDIO_TASK_BUDGET_CENTS=100
STUDIO_BUDGET_ID=
STUDIO_STOP_AT=
# Existing remote dashboards/agents are not modified by npm start.
PMF_APP_URL=
PMF_ADMIN_TOKEN=
