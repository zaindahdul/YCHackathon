{
  "name": "naive-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "company": "tsx src/cli.ts",
    "check": "npm run typecheck && npm test",
    "demo": "tsx src/cli.ts demo",
    "format": "prettier --write src tests config package.json tsconfig.json",
    "format:check": "prettier --check src tests config package.json tsconfig.json"
  },
  "dependencies": {
    "@usenaive-sdk/managed-agents": "0.12.3",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
