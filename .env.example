# Copy to .env; never commit actual keys. No key is provisioned here.
NAIVE_API_KEY=
NAIVE_MODEL=vetta/auto
# Owner API token and separate per-customer capability signing secret (owner: 24+ chars; customer: 32+ chars).
COMPANY_API_TOKEN=
COMPANY_CUSTOMER_SECRET=
# Set to your actual HTTPS service URL before offering checkout to customers.
COMPANY_PUBLIC_URL=http://127.0.0.1:3000
# Optional real payments; live/test are distinguished by signed provider events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
